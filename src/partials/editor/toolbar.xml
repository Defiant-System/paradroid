
<ToolBar>
	<ToolSet id="background" state="active">
		<Group width="150px">
			<!-- <Select name="Background" menu="editor-layer"></Select> -->
			<Options type="grouped">
				<Tool symbol="icon-new" title="New Ship"/>
				<Tool symbol="icon-save" title="Save"/>
				<Tool symbol="icon-folder" title="Open file"/>
			</Options>
		</Group>
		<Group width="calc( 100% - 150px )">
			<Options type="grouped">
				<Tool symbol="icon-mountain-mini" title="Minimap" click="grid-size" arg=".25"/>
				<Tool symbol="icon-mountain" title="Normal size" click="grid-size" arg="1" state="active"/>
			</Options>
			<Options type="grouped">
				<Tool symbol="icon-eraser" title="Eraser" click="cursor-eraser"/>
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<Tool symbol="icon-grid" title="Grid" click="toggle-grid" state="active"/>
			</Options>
			<Tool symbol="icon-palette" menu="bg-color"/>
			<Options type="grouped">
				<Tool symbol="icon-bg-color" click="set-bg-alpha" arg="0"/>
				<Tool symbol="icon-bg-transparent" click="set-bg-alpha" arg=".35" state="active"/>
				<Tool symbol="icon-bg-image" click="set-bg-alpha" arg="1"/>
			</Options>
		</Group>
		<Group></Group>
	</ToolSet>

	<ToolSet id="collision">
		<Group>
			<Select name="Background" menu="editor-layer"></Select>
			<Divider />
			<Options type="grouped">
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<!-- <Tool name="PGN" click="output-collision-pgn"/> -->
			</Options>
			<Tool name="Duplicate" click="col-duplicate-active"/>
			<Tool name="Delete" click="col-delete-active"/>
		</Group>
	</ToolSet>

	<ToolSet id="action">
		<Group>
			<Select name="Background" menu="editor-layer"></Select>
			<Divider />
			<Options type="grouped">
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<!-- <Tool name="PGN" click="output-action-pgn"/> -->
			</Options>
		</Group>
	</ToolSet>

	<ToolSet id="los">
		<Group>
			<Select name="Background" menu="editor-layer"></Select>
			<Divider />
			<Options>
				<Tool name="Add" click="los-add-segment"/>
				<Tool name="Delete" click="los-delete-segment"/>
			</Options>
			<Options type="grouped">
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<!-- <Tool name="PGN" click="output-los-pgn"/> -->
			</Options>
		</Group>
	</ToolSet>

	<ToolSet id="lights">
		<Group>
			<Select name="Background" menu="editor-layer"></Select>
			<Divider />
			<Tool name="Duplicate" click="lights-duplicate"/>
			<Tool name="Delete" click="lights-delete"/>
			<Options type="grouped">
				<Tool name="Helpers" click="toggle-lights-helpers"/>
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<!-- <Tool name="PGN" click="output-lights-pgn"/> -->
			</Options>
		</Group>
	</ToolSet>

	<ToolSet id="droids">
		<Group>
			<Select name="Droids" menu="editor-layer"></Select>
			<Divider />
			<Tool name="Center" click="center-patrol-point"/>
			<Tool name="Delete" click="delete-patrol-point"/>
			<Options type="grouped">
				<Tool symbol="icon-crop" title="Overflow" click="toggle-overflow" state="active"/>
				<!-- <Tool name="PGN" click="output-patrol-pgn"/> -->
			</Options>
		</Group>
	</ToolSet>
</ToolBar>
